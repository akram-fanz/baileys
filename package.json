{
  "name": "@vibersmoon/baileys",
  "version": "1.0.0",
  "description": "Production-ready Baileys WhatsApp library wrapper by Akram",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "bot",
    "vibersmoon",
    "akram"
  ],
  "author": "Akram",
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "tsx": "^4.19.1",
    "vitest": "^2.1.1",
    "@types/node": "^22.5.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
